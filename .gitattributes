# Auto-detect text files and normalize line endings
* text=auto eol=lf

# Java files
*.java text eol=lf

# JavaScript/JSX files
*.js text eol=lf
*.jsx text eol=lf

# CSS files
*.css text eol=lf

# JSON files
*.json text eol=lf
*.json5 text eol=lf

# XML files
*.xml text eol=lf

# Properties files
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# SQL files
*.sql text eol=lf

# Markdown files
*.md text eol=lf

# Images and binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.ico binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# OS-generated files
.DS_Store text
Thumbs.db text
